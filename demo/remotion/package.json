{
  "name": "assemblypilot-hackathon-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audio": "node scripts/generate-audio.ts",
    "check": "node scripts/check-footage.ts",
    "align": "python3 scripts/align-voice.py",
    "voice": "node scripts/build-voice-timing.ts",
    "diagram": "remotion still src/index.ts ArchitectureDiagram public/architecture/assemblypilot-architecture.png --scale=2",
    "mapping": "node scripts/write-clip-mapping.ts",
    "prepare:assets": "npm run check && npm run audio && npm run voice && npm run mapping",
    "preview": "remotion studio src/index.ts",
    "render:preview": "npm run prepare:assets && remotion render src/index.ts AssemblyPilotDemo out/preview.mp4 --scale=0.5 --crf=28",
    "render": "npm run prepare:assets && remotion render src/index.ts AssemblyPilotDemo out/assemblypilot-hackathon-demo.mp4 --codec=h264 --crf=18",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "@remotion/fonts": "4.0.540",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
