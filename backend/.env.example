# Required only for explicit Meta inspection; camera, registry and offline tests work without it.
MODEL_API_KEY=
# Meta-only HTTPS endpoint. Never put the key in frontend configuration.
META_API_BASE_URL=https://api.meta.ai/v1
META_VISION_MODEL=muse-spark-1.3
# Optional Meta-hosted localization; false retains Muse-only inspection.
META_SAM_MODEL=sam-3.1
SAM_ENABLED=true
# Total seconds per SAM operation, including retries and decoding (maximum 60).
SAM_REQUEST_TIMEOUT=60
# 0–2 localization operations; each may retry transient failures up to 3 attempts.
SAM_MAX_CONCEPTS_PER_INSPECTION=2
META_REQUEST_TIMEOUT=60
INSPECTION_MAX_DIMENSION=1280
META_MAX_REFERENCE_IMAGES=8
META_MAX_REQUEST_BYTES=10485760
FRONTEND_ORIGIN=http://localhost:3000
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_PIXELS=20000000
MAX_IMAGE_DIMENSION=8192
MIN_IMAGE_DIMENSION=32
RESIZE_MAX_DIMENSION=1600

# Relative paths are always resolved from backend/, regardless of the shell CWD.
DATABASE_URL=sqlite:///./data/assemblypilot.db
UPLOAD_DIR=./data/uploads

# Phase 4: bounded, single-process metadata sessions; no camera bytes retained.
INSPECTION_SESSION_CAPACITY=64
INSPECTION_SESSION_TTL_SECONDS=1800

# Phase 4.1A: versioned calibration JSON only; no calibration photographs saved.
CALIBRATION_DIR=./data/calibrations

# Adaptive Canny threshold spread for registered printed-face matching (0.1–0.6).
FACE_CANNY_SIGMA=0.33

# Local voice (Whisper on this Mac; models live outside the repo, never committed).
# Preferred on Apple Silicon: brew install whisper-cpp, download ggml-base.bin
# from huggingface.co/ggerganov/whisper.cpp into ~/.local/share/assemblypilot-voice/
# VOICE_WHISPER_COMMAND=whisper-cli
# VOICE_WHISPER_MODEL_PATH=/Users/you/.local/share/assemblypilot-voice/ggml-base.bin
# Fallback: openai-whisper CLI (`whisper`) with VOICE_WHISPER_MODEL=tiny (slower:
# the model is reloaded per clip). Empty command auto-detects whisper-cli, main, whisper.
