# Optional for a later phase. No credentials needed for Phases 1–2.
MODEL_API_KEY=
# Reserved configuration only; verify endpoint/model in official Meta docs before integration.
META_API_BASE_URL=https://api.meta.ai/v1
META_VISION_MODEL=
FRONTEND_ORIGIN=http://localhost:3000
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_PIXELS=20000000
MAX_IMAGE_DIMENSION=8192
MIN_IMAGE_DIMENSION=32
RESIZE_MAX_DIMENSION=1600

# Relative paths are always resolved from backend/, regardless of the shell CWD.
DATABASE_URL=sqlite:///./data/assemblypilot.db
UPLOAD_DIR=./data/uploads
