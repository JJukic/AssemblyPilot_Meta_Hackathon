# Required only for explicit Meta inspection; camera, registry and offline tests work without it.
MODEL_API_KEY=
# Meta-only HTTPS endpoint. Never put the key in frontend configuration.
META_API_BASE_URL=https://api.meta.ai/v1
META_VISION_MODEL=muse-spark-1.3
META_REQUEST_TIMEOUT=60
INSPECTION_MAX_DIMENSION=1280
META_MAX_REFERENCE_IMAGES=8
META_MAX_REQUEST_BYTES=10485760
FRONTEND_ORIGIN=http://localhost:3000
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_PIXELS=20000000
MAX_IMAGE_DIMENSION=8192
MIN_IMAGE_DIMENSION=32
RESIZE_MAX_DIMENSION=1600

# Relative paths are always resolved from backend/, regardless of the shell CWD.
DATABASE_URL=sqlite:///./data/assemblypilot.db
UPLOAD_DIR=./data/uploads
